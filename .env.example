# ==============================================================================
# VARIABLES DE ENTORNO - LUZ BEAUTY STUDIO (PLANTILLA)
# ==============================================================================
# Copia este archivo como `.env` para desarrollo local cuando se inicialice el
# frontend. NUNCA subas el archivo `.env` real a GitHub.
#
# NOTA: Los prefijos exactos (ej. VITE_*, NEXT_PUBLIC_*, PUBLIC_*) dependerán
# del framework frontend que se seleccione (PENDIENTE DE CONFIRMACIÓN).
# ==============================================================================

# URL pública del proyecto en Supabase (ej. https://tu-proyecto.supabase.co)
PUBLIC_SUPABASE_URL=

# Clave pública anónima de Supabase (NUNCA usar service_role key en frontend)
PUBLIC_SUPABASE_ANON_KEY=

# Número oficial de WhatsApp en formato internacional sin '+' ni espacios
# Estado: PENDIENTE DE CONFIRMACIÓN (ej. 50760000000)
PUBLIC_WHATSAPP_NUMBER=
